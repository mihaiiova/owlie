{
  "name": "@owlieio/adapter-hackernews",
  "version": "0.1.0",
  "private": true,
  "description": "Hacker News source adapter for Owlie CLI",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts packages/adapter-hackernews"
  },
  "dependencies": {
    "@owlieio/core": "workspace:*",
    "entities": "^8.0.0"
  },
  "devDependencies": {
    "@owlieio/testing": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
