{
  "name": "@owlieio/provider-openai",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI content processor provider for Owlie CLI",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
