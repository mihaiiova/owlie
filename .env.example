# Owlie CLI environment configuration.
#
# Copy this file to .env.local (or another path you pass with --env-file) for
# local development. Never commit real credentials, and never paste values back
# into this example file.
#
# Environment variables are read with the following precedence (highest first):
#   command-line flags
#   process environment
#   .env.local
#   .env
#   user configuration file
#   documented defaults

# --- LLM providers (v0.1, functional) -------------------------------------
# `owlie process` selects a provider explicitly (--provider, OWLIE_PROVIDER, or
# the saved active provider) and then resolves that provider's variables below.
# Values are never logged or printed.

# DeepSeek content processor.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Model used when --model is not passed on the command line.
DEEPSEEK_MODEL=

# OpenAI content processor. There is no default OpenAI model; the model
# selected by setup, environment, or --model is required for processing.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Deferred provider (scaffold; not functional in v0.1) ------------------
# Local Whisper transcription — deferred, not implemented.
OWLIE_TRANSCRIPTION_PROVIDER=whisper-local
OWLIE_TRANSCRIPTION_MODEL=small
OWLIE_TRANSCRIPTION_LANGUAGE=auto
OWLIE_TRANSCRIPTION_COMPUTE_TYPE=int8
