# Owlie CLI environment configuration.
#
# Copy this file to .env.local (or another path you pass with --env-file) for
# local development. Never commit real credentials, and never paste values back
# into this example file.
#
# Environment variables are read with the following precedence (highest first):
#   command-line flags
#   process environment
#   .env.local
#   .env
#   user configuration file
#   documented defaults

# --- DeepSeek content processor (v0.1, functional) -------------------------
# Required to run `owlie process`. Values are never logged or printed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Model used when --model is not passed on the command line.
DEEPSEEK_MODEL=

# --- Deferred providers (scaffolds; not functional in v0.1) ----------------
# OpenAI content processor — deferred, not implemented.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Local Whisper transcription — deferred, not implemented.
OWLIE_TRANSCRIPTION_PROVIDER=whisper-local
OWLIE_TRANSCRIPTION_MODEL=small
OWLIE_TRANSCRIPTION_LANGUAGE=auto
OWLIE_TRANSCRIPTION_COMPUTE_TYPE=int8
