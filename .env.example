# Owlie CLI environment configuration.
#
# Copy this file to .env.local (or another path you pass with --env-file) for
# local development. Never commit real credentials, and never paste values back
# into this example file.
#
# Environment variables are read with the following precedence (highest first):
#   command-line flags
#   process environment
#   .env.local
#   .env
#   user configuration file
#   documented defaults

# --- OpenAI content processor ----------------------------------------------
# Set only if you use the OpenAI provider. Values are never logged or printed.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Local Whisper transcription -------------------------------------------
# faster-whisper runs locally and requires no API key. These control defaults.
OWLIE_TRANSCRIPTION_PROVIDER=whisper-local
OWLIE_TRANSCRIPTION_MODEL=small
OWLIE_TRANSCRIPTION_LANGUAGE=auto
OWLIE_TRANSCRIPTION_COMPUTE_TYPE=int8
