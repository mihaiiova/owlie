{
  "name": "owlie-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first content extraction and processing CLI (monorepo)",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "smoke": "node scripts/cli-smoke.mjs",
    "cli": "node apps/cli/dist/bin.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:deps && pnpm build && pnpm verify:exports && pnpm smoke",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "pnpm build && pnpm --filter owlie publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
