{
  "name": "@owlieio/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Owlie CLI",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "owlie": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts apps/cli"
  },
  "dependencies": {
    "@owlieio/core": "workspace:*",
    "@owlieio/adapter-youtube": "workspace:*",
    "@owlieio/adapter-podcast": "workspace:*",
    "@owlieio/adapter-rss": "workspace:*",
    "@owlieio/adapter-reddit": "workspace:*",
    "@owlieio/provider-openai": "workspace:*",
    "@owlieio/provider-whisper": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
