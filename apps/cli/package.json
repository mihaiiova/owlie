{
  "name": "@owlieio/owlie",
  "version": "0.9.2-dev",
  "description": "Ask an LLM about any URL, or turn it into clean text: articles, PDFs, arXiv papers, YouTube transcripts, podcasts, RSS/Atom feeds and Hacker News",
  "keywords": [
    "cli",
    "llm",
    "web-content-extraction",
    "article-extraction",
    "pdf",
    "pdf-to-text",
    "arxiv",
    "research-papers",
    "readability",
    "youtube",
    "youtube-transcript",
    "transcripts",
    "podcast",
    "apple-podcasts",
    "whisper",
    "rss",
    "atom",
    "feed",
    "hacker-news",
    "deepseek",
    "openai",
    "jsonl"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaiiova/owlie.git"
  },
  "homepage": "https://github.com/mihaiiova/owlie#readme",
  "bugs": {
    "url": "https://github.com/mihaiiova/owlie/issues"
  },
  "bin": {
    "owlie": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.69",
    "@ai-sdk/openai": "^4.0.98",
    "@hallelx/youtube-transcript": "^0.2.0",
    "ai": "^7.0.146",
    "undici": "^7.30.0",
    "unpdf": "1.8.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts apps/cli"
  },
  "devDependencies": {
    "@owlieio/adapter-article": "workspace:*",
    "@owlieio/adapter-arxiv": "workspace:*",
    "@owlieio/adapter-hackernews": "workspace:*",
    "@owlieio/adapter-podcast": "workspace:*",
    "@owlieio/adapter-reddit": "workspace:*",
    "@owlieio/adapter-rss": "workspace:*",
    "@owlieio/adapter-youtube": "workspace:*",
    "@owlieio/core": "workspace:*",
    "@owlieio/provider-deepseek": "workspace:*",
    "@owlieio/provider-openai": "workspace:*",
    "@owlieio/provider-whisper": "workspace:*",
    "@owlieio/testing": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
