{
  "name": "owlie",
  "version": "0.1.0",
  "description": "Local-first content extraction and processing CLI",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "owlie": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "ai": "^7.0.68",
    "@ai-sdk/deepseek": "^3.0.32",
    "@hallelx/youtube-transcript": "^0.2.0",
    "undici": "^7.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts apps/cli"
  },
  "devDependencies": {
    "@owlieio/adapter-article": "workspace:*",
    "@owlieio/adapter-podcast": "workspace:*",
    "@owlieio/adapter-reddit": "workspace:*",
    "@owlieio/adapter-rss": "workspace:*",
    "@owlieio/adapter-youtube": "workspace:*",
    "@owlieio/core": "workspace:*",
    "@owlieio/provider-deepseek": "workspace:*",
    "@owlieio/provider-openai": "workspace:*",
    "@owlieio/provider-whisper": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
